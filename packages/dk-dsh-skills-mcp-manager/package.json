{
  "name": "dk-dsh-skills-mcp-manager",
  "version": "0.2.1",
  "description": "统一管理 DSH Skills 与 MCP，内置递归技能发现",
  "type": "module",
  "license": "Apache-2.0 AND MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "recursive-skills.js",
    "client.js",
    "cordis.patch.yml",
    "vendor",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
